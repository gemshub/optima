# Recommended cmake macro use to write a cmake config file.
@PACKAGE_INIT@

# Ensure dependencies from the conda environment are used (e.g., Boost).
list(APPEND CMAKE_PREFIX_PATH $ENV{CONDA_PREFIX})

# Eigen: use the one Optima was built with. A different or missing Eigen reports Optima as not found,
# so find_package(Optima QUIET) can go on and find_package(Optima REQUIRED) stops with the message.
set(_optima_eigen_dir "@Eigen3_DIR@")
set(_optima_eigen_version "@Eigen3_VERSION@")
if(Eigen3_DIR AND NOT Eigen3_DIR STREQUAL _optima_eigen_dir AND EXISTS "${Eigen3_DIR}/Eigen3ConfigVersion.cmake")
    # An Eigen was chosen by the caller: it must be the same version.
    file(STRINGS "${Eigen3_DIR}/Eigen3ConfigVersion.cmake" _optima_user_ver REGEX "set\\(PACKAGE_VERSION \"[0-9.]+\"")
    string(REGEX MATCH "[0-9]+\\.[0-9]+(\\.[0-9]+)?" _optima_user_eigen_version "${_optima_user_ver}")
    if(NOT _optima_user_eigen_version VERSION_EQUAL _optima_eigen_version)
        string(CONCAT Optima_NOT_FOUND_MESSAGE "Optima was built with Eigen ${_optima_eigen_version} (${_optima_eigen_dir}), "
                                               "but Eigen3_DIR=${Eigen3_DIR} is Eigen ${_optima_user_eigen_version}. "
                                               "Remove Eigen3_DIR or point it to Eigen ${_optima_eigen_version}.")
        set(Optima_FOUND FALSE)
        return()
    endif()
endif()
find_package(Eigen3 ${_optima_eigen_version} EXACT QUIET CONFIG PATHS "${_optima_eigen_dir}" NO_DEFAULT_PATH)
if(NOT Eigen3_FOUND)
    string(CONCAT Optima_NOT_FOUND_MESSAGE "Optima was built with Eigen ${_optima_eigen_version} (${_optima_eigen_dir}), "
                                           "which was not found. Install that Eigen or set Eigen3_DIR to an Eigen ${_optima_eigen_version}.")
    set(Optima_FOUND FALSE)
    return()
endif()

# Include the cmake targets of the project if they have not been yet.
if(NOT TARGET Optima::Optima)
    include("@PACKAGE_OPTIMA_INSTALL_CONFIGDIR@/OptimaTargets.cmake")
endif()

# Recommended check at the end of a cmake config file.
check_required_components(Optima)
